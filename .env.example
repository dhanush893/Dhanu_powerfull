# Copy these values into your hosting provider's environment variables.
# Do not commit real credentials or bot tokens.

API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_telegram_bot_token

# MongoDB Atlas connection strings
DATABASE_URI=mongodb+srv://USER:PASSWORD@PRIMARY_CLUSTER/...
DATABASE_URI2=mongodb+srv://USER:PASSWORD@SECONDARY_CLUSTER/...
DATABASE_NAME=imdb
COLLECTION_NAME=Deendayal_files

# Telegram IDs (numeric IDs; use a private channel where the bot is an admin)
LOG_CHANNEL=your_log_channel_id
BIN_CHANNEL=your_bin_channel_id
ADMINS=your_telegram_user_id
OWNERID=your_telegram_user_id

# Optional server settings
PORT=8080
NO_PORT=True
STREAM_MODE=False
